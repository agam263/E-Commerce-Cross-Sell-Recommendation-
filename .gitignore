# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Data: raw data is immutable input, never committed
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Build artifacts: keep the shipped rule set tracked so Render can serve it
# directly without downloading/parsing the 23 MB Excel file at deploy time.
artifacts/*
!artifacts/.gitkeep
!artifacts/latest.json
!artifacts/rs-43465a06-090dfeb4/
!artifacts/rs-43465a06-090dfeb4/**

# Report figures ARE committed: evaluation_report.md embeds them, so excluding
# them would render the report with broken images on GitHub.

# Node
node_modules/
frontend/dist/
.DS_Store
.env
